{
  "name": "arcade-redesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test checks/inventory.check.mjs && node checks/unit/run.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "format": "prettier --write src checks scripts *.ts *.json",
    "check:format": "prettier --check src checks scripts *.ts *.json",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
